{
  "name": "ynk-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/intelligence.mjs",
    "dev": "vite",
    "prebuild": "node scripts/intelligence.mjs",
    "build": "vite build",
    "validate:intelligence": "node scripts/intelligence.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "gas:status": "cd ../integrations/google-apps-script && clasp show-file-status",
    "gas:push": "node -e \"require('fs').accessSync('../integrations/google-apps-script/Private.gs')\" && cd ../integrations/google-apps-script && clasp push --force",
    "gas:pull": "cd ../integrations/google-apps-script && clasp pull",
    "gas:deploy": "npm run gas:push && cd ../integrations/google-apps-script && clasp update-deployment AKfycby0N2pE9CuP45h_yXgRbFBV7jQU0EKYjKptdiA5M2CL39laLRTtd7L89jtDBwtJaNxHkQ --description \"Public intake\""
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
